---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const steps = [
  { number: "01", label: "Use Case Owner", description: "Define the AI use case and submit risks for assessment.", href: `${base}/steps/step1/usecase-creation-model-owner` },
  { number: "02", label: "Risk & Compliance Officer", description: "Review, assess, and endorse the risk associated with the use case.", href: `${base}/steps/step2/risk-endorsement-bul` },
  { number: "03", label: "Model Developer", description: "Build and evaluate prompts and agents for the generative AI use case.", href: `${base}/steps/step3/model-developer-tasks` },
  { number: "04", label: "Model Validator", description: "Validate model performance, hallucination metrics, and governance readiness.", href: `${base}/steps/step4/model-validator-tasks` },
  { number: "05", label: "AIOps Engineer", description: "Deploy and monitor the AI model on watsonx.governance.", href: `${base}/steps/step5/model-deployer-tasks` },
  { number: "06", label: "Risk & Compliance Officer", description: "Review and mitigate incidents that arise once the model is in production.", href: `${base}/steps/step6/mitigating-incidents` },
];
---

<BaseLayout title="Session 2">

  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-100">
    <div class="pointer-events-none absolute -top-20 -right-20 w-80 h-80 rounded-full"
         style="background: radial-gradient(circle, rgba(167,139,250,0.3) 0%, rgba(196,181,253,0.08) 60%, transparent 80%);"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 w-64 h-64 rounded-full"
         style="background: radial-gradient(circle, rgba(147,197,253,0.2) 0%, transparent 70%);"></div>
    <div class="relative max-w-7xl mx-auto px-8 py-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-3">Session 2 &nbsp;·&nbsp; Hands-on Lab</p>
      <h1 class="text-5xl font-bold leading-tight tracking-tight text-gray-900 max-w-3xl">
        Managing AI Risk and<br />
        <span class="text-violet-600">Compliance</span> with watsonx.governance
      </h1>
      <p class="mt-5 text-lg text-gray-500 max-w-2xl leading-relaxed">
        A story-driven lab covering the full AI governance lifecycle — from use case creation to production incident management.
      </p>
      <a href={`${base}/steps/step1/usecase-creation-model-owner`}
        class="inline-block mt-8 bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold px-7 py-3 rounded-xl transition-colors">
        Start the lab →
      </a>
    </div>
  </div>

  <!-- Steps grid -->
  <div class="max-w-7xl mx-auto px-8 py-16">
    <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Journey</p>
    <h2 class="text-2xl font-bold text-gray-900 mb-10">6-step AI Governance workflow</h2>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((step) => (
        <a href={step.href}
          class="group block border border-gray-200 rounded-2xl p-6 hover:border-violet-300 hover:shadow-md transition-all">
          <div class="flex items-center gap-3 mb-4">
            <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-violet-50 border border-violet-200 text-violet-600 text-sm font-bold shrink-0">
              {step.number}
            </span>
          </div>
          <h3 class="text-base font-semibold text-gray-900 group-hover:text-violet-700 mb-1">{step.label}</h3>
          <p class="text-sm text-gray-500 leading-relaxed">{step.description}</p>
          <div class="mt-4 text-sm font-semibold text-violet-600 group-hover:underline">View guide →</div>
        </a>
      ))}
    </div>

    <!-- Prerequisites -->
    <div class="mt-14 border border-violet-200 bg-violet-50 rounded-2xl p-7">
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">Before you start</p>
      <h2 class="text-base font-semibold text-gray-900 mb-4">Prerequisites</h2>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex gap-2"><span class="text-violet-400 font-bold">·</span> Access credentials provided by the instructor</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold">·</span> IBM Cloud login with assigned stakeholder role</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold">·</span> Services: OpenPages with MRG (Main Labs), Model Management (Additional Labs)</li>
      </ul>
    </div>
  </div>

</BaseLayout>
