---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const fixes = [
  "Track every AI model from start to finish",
  "Make sure models follow the rules (GDPR, EU AI Act, etc.)",
  "Foster collaboration with the development team — without slowing them down",
  "Catch problems early and fix them fast",
  "Keep everything ready for audits",
];

const journey = [
  { number: "01", title: "Inception", desc: "Create a new model use case request and complete initial risk and compliance assessments.", owner: "Model Owner, Business Owner, Data Engineer" },
  { number: "02", title: "Stakeholder Review", desc: "Review risk level and compliance applicability; approve or reject the use case.", owner: "Business Unit Leader, Head of Risk, Compliance Officer" },
  { number: "03", title: "Model Development", desc: "Build and test the AI model; evaluate performance of different models.", owner: "AI Engineer, Data Engineer, Data Scientist" },
  { number: "04", title: "Model Validation & Approval", desc: "Review the model, perform an ethics assessment, and approve it for production.", owner: "Head of AI, Head of Risk" },
  { number: "05", title: "Deploy, Manage, Monitor & Report", desc: "Deploy the approved AI use case/model and automate performance and risk monitoring.", owner: "Head of IT, MLOps Engineer" },
  { number: "06", title: "Incident Management", desc: "Take remediation actions to mitigate risks and update stakeholders after remediation.", owner: "Model Owner, Business Owner, Data Scientist" },
];

const personas = [
  { icon: "👤", role: "Use Case Owner", desc: "Defines the AI use case and submits risks for assessment." },
  { icon: "🛡️", role: "Risk & Compliance Officer", desc: "Reviews, assesses and endorses risk. Manages production incidents." },
  { icon: "👩‍💻", role: "Model Developer", desc: "Builds and evaluates prompts and agents in Prompt Lab & Agent Lab." },
  { icon: "🔍", role: "Model Validator", desc: "Validates model performance, hallucination metrics and governance readiness." },
  { icon: "⚙️", role: "AIOps Engineer", desc: "Deploys and monitors the AI model on watsonx.governance." },
];

const steps = [
  {
    number: "01", label: "Use Case Owner",
    guides: [
      { title: "Use Case Creation", href: `${base}/steps/step1/usecase-creation-model-owner`, type: "MRG Console" },
      { title: "Risk Review (RCO)", href: `${base}/steps/step1/risk-review-rco`, type: "MRG Console" },
    ],
  },
  {
    number: "02", label: "Risk & Compliance Officer",
    guides: [
      { title: "Risk Endorsement", href: `${base}/steps/step2/risk-endorsement-bul`, type: "MRG Console" },
    ],
  },
  {
    number: "03", label: "Model Developer",
    guides: [
      { title: "Developer Tasks", href: `${base}/steps/step3/model-developer-tasks`, type: "MRG Console" },
      { title: "Model Development", href: `${base}/steps/step3/model-developement`, type: "Model Management" },
    ],
  },
  {
    number: "04", label: "Model Validator",
    guides: [
      { title: "Validator Tasks", href: `${base}/steps/step4/model-validator-tasks`, type: "MRG Console" },
      { title: "Model Validation", href: `${base}/steps/step4/model-validation`, type: "Model Management" },
    ],
  },
  {
    number: "05", label: "AIOps Engineer",
    guides: [
      { title: "Deployer & Monitoring Tasks", href: `${base}/steps/step5/model-deployer-tasks`, type: "MRG Console" },
      { title: "Model Deployment", href: `${base}/steps/step5/model-deployment`, type: "Model Management" },
    ],
  },
  {
    number: "06", label: "Risk & Compliance Officer",
    guides: [
      { title: "Mitigating Incidents", href: `${base}/steps/step6/mitigating-incidents`, type: "MRG Console" },
      { title: "Model Management Evals", href: `${base}/steps/step6/model-management-evals`, type: "Model Management" },
      { title: "Integrating External Evals", href: `${base}/steps/step6/integrating-external-evals`, type: "Model Management" },
    ],
  },
];
---

<BaseLayout title="Session 2">

  <!-- Hero -->
  <div class="relative overflow-hidden border-b border-gray-100">
    <div class="pointer-events-none absolute top-0 right-0 w-[460px] h-[460px] rounded-full translate-x-1/3 -translate-y-1/3"
         style="background: radial-gradient(circle, rgba(167,139,250,0.28) 0%, rgba(196,181,253,0.08) 55%, transparent 75%);"></div>
    <div class="pointer-events-none absolute bottom-0 left-0 w-[380px] h-[380px] rounded-full -translate-x-1/3 translate-y-1/3"
         style="background: radial-gradient(circle, rgba(147,197,253,0.35) 0%, rgba(191,219,254,0.1) 55%, transparent 75%);"></div>
    <div class="relative max-w-5xl mx-auto px-8 py-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-3">Session 2 &nbsp;·&nbsp; Hands-on Lab</p>
      <h1 class="text-5xl font-bold leading-tight tracking-tight text-gray-900 max-w-3xl">
        Managing AI Risk and<br />
        <span class="text-violet-600">Compliance</span><br />with watsonx.governance
      </h1>
      <p class="mt-5 text-base text-gray-500 max-w-xl leading-relaxed">
        Jose works at <strong>TechCorp Inc.</strong>, a large multinational enterprise using AI to improve HR processes like hiring and employee planning. AI was everywhere, but nobody really knew who built what, whether models were fair and safe, or what to do when something went wrong. So, Jose and his team decided to leverage <strong>watsonx.governance</strong> to make AI governance easy, clear, and reliable.
      </p>
      <a href={`${base}/steps/step1/usecase-creation-model-owner`}
        class="inline-block mt-8 bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold px-7 py-3 rounded-xl transition-colors">
        Start the lab →
      </a>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-8 py-14 space-y-16">

    <!-- What Jose wanted to fix -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Goal</p>
      <h2 class="text-xl font-bold text-gray-900 mb-2">What Jose wanted to fix</h2>
      <p class="text-sm text-gray-500 max-w-2xl leading-relaxed mb-6">
        Jose didn't want to manage critical governance processes through spreadsheets, emails, or Slack messages — he wanted one simple system for it all.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {fixes.map((f) => (
          <div class="flex items-start gap-2.5 rounded-xl bg-violet-50 border border-violet-100 px-4 py-3">
            <span class="text-violet-500 mt-0.5 shrink-0">✅</span>
            <span class="text-sm text-gray-700 leading-relaxed">{f}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Prerequisites -->
    <div class="border border-violet-200 bg-violet-50 rounded-2xl p-7">
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">Before you start</p>
      <h2 class="text-base font-semibold text-gray-900 mb-4">Prerequisites</h2>
      <ul class="text-sm text-gray-600 space-y-2">
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Access credentials provided by the instructor</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> IBM Cloud login with assigned stakeholder role</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Services: OpenPages with MRG (Main Labs), Model Management (Additional Labs)</li>
      </ul>
      <p class="mt-4 text-xs text-gray-500 leading-relaxed border-t border-violet-200 pt-4">
        💡 In this lab you'll work through a real AI Governance use case with your team, each member taking on one of the personas below. For simplicity, every profile is granted privileges to run any persona's steps, through the <strong>watsonx-governance MRG Master</strong> profile.
      </p>
    </div>

    <!-- Personas -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Team</p>
      <h2 class="text-xl font-bold text-gray-900 mb-6">Who's involved in AI Governance?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {personas.map((p) => (
          <div class="flex gap-3 border border-gray-100 rounded-xl p-4 bg-gray-50">
            <span class="text-2xl">{p.icon}</span>
            <div>
              <p class="text-sm font-semibold text-gray-900">{p.role}</p>
              <p class="text-xs text-gray-500 mt-1 leading-relaxed">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- AI Governance Journey -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Journey</p>
      <h2 class="text-xl font-bold text-gray-900 mb-2">The AI Governance journey in 6 steps</h2>
      <p class="text-sm text-gray-500 max-w-2xl leading-relaxed mb-8">
        A simple, structured process for managing AI models from idea to remediation — the same one Jose's team uses today.
      </p>

      <div class="rounded-2xl border border-gray-200 overflow-hidden">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 divide-y sm:divide-y-0 lg:divide-x divide-gray-100">
          {journey.map((j) => (
            <div class="p-5 bg-gray-50">
              <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-violet-100 border border-violet-200 text-violet-700 text-[11px] font-bold mb-3">
                {j.number}
              </span>
              <p class="text-sm font-semibold text-gray-900 leading-snug">{j.title}</p>
              <p class="text-xs text-gray-500 mt-1.5 leading-relaxed">{j.desc}</p>
              <p class="text-[11px] text-violet-500 font-medium mt-3 leading-snug">Owner: {j.owner}</p>
            </div>
          ))}
        </div>
        <div class="bg-violet-600 text-white text-center text-xs font-semibold tracking-wide uppercase py-2.5">
          Continuous AI Governance
        </div>
      </div>
    </div>

    <!-- Lab Guides -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Guides</p>
      <h2 class="text-xl font-bold text-gray-900 mb-8">Lab guides directory</h2>

      <div class="space-y-4">
        {steps.map((step) => (
          <div class="border border-gray-200 rounded-2xl overflow-hidden">
            <!-- Step header -->
            <div class="flex items-center gap-3 px-5 py-3 bg-gray-50 border-b border-gray-200">
              <span class="flex items-center justify-center w-7 h-7 rounded-lg bg-violet-100 border border-violet-200 text-violet-700 text-xs font-bold shrink-0">
                {step.number}
              </span>
              <span class="text-sm font-semibold text-gray-700">{step.label}</span>
            </div>
            <!-- Guides -->
            <div class="divide-y divide-gray-100">
              {step.guides.map((guide) => (
                <a href={guide.href}
                   class="flex items-center justify-between px-5 py-3 hover:bg-violet-50 transition-colors group">
                  <span class="text-sm text-gray-800 group-hover:text-violet-700 font-medium">{guide.title}</span>
                  <span class="text-xs text-gray-400 bg-gray-100 rounded px-2 py-0.5 shrink-0 ml-4">{guide.type}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- What Jose says now -->
    <div>
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">The Result</p>
      <h2 class="text-xl font-bold text-gray-900 mb-2">What Jose says now</h2>
      <p class="text-sm text-gray-500 max-w-2xl leading-relaxed mb-6">
        With watsonx.governance in place, Jose's team finally has one clear process from intake to remediation — every model is tracked, every risk assessed, and audits are no longer a scramble.
      </p>
      <blockquote class="relative border-l-4 border-violet-400 bg-violet-50 rounded-r-2xl px-8 py-7 overflow-hidden">
        <span class="pointer-events-none absolute -top-4 -left-1 text-7xl font-serif text-violet-200 select-none">&ldquo;</span>
        <p class="relative text-base text-violet-900 italic leading-relaxed max-w-2xl">
          Before watsonx.governance, we had no clear process. Now everyone knows what to do, models are better, and we're always ready for audits.
        </p>
        <footer class="relative mt-3 text-xs text-violet-500 font-semibold">— Jose, Chief Risk Officer, TechCorp Inc.</footer>
      </blockquote>
    </div>

    <!-- Congratulations / wrap-up -->
    <div class="border border-gray-200 rounded-2xl p-7">
      <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">🎉 By the end of this lab</p>
      <h2 class="text-base font-semibold text-gray-900 mb-4">You'll have helped govern this Agentic AI use case by</h2>
      <ul class="text-sm text-gray-600 space-y-2 mb-5">
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Validating risk levels</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Confirming regulatory and internal compliance</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Approving only well-governed use cases</li>
        <li class="flex gap-2"><span class="text-violet-400 font-bold mt-0.5">·</span> Ensuring model fairness and quality through continuous validation</li>
      </ul>
      <p class="text-xs text-gray-500 leading-relaxed border-t border-gray-100 pt-4">
        🛡️ Governance is not a one-time check — it's a continuous loop of accountability and alignment.
      </p>
    </div>

  </div>

</BaseLayout>
