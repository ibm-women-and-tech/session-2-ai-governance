---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
export async function getStaticPaths() {
  const entries = await getCollection('steps');
  return entries.map((entry) => {
    const parts = entry.id.split('/');
    const step = parts[0];
    const slug = parts[1];
    return {
      params: { step, slug },
      props: { entry },
    };
  });
}

const stepLabels: Record<string, string> = {
  step1: 'Use Case Owner',
  step2: 'Risk & Compliance Officer',
  step3: 'Model Developer',
  step4: 'Model Validator',
  step5: 'AIOps Engineer',
  step6: 'Risk & Compliance Officer',
};

const stepNumbers: Record<string, string> = {
  step1: '01', step2: '02', step3: '03',
  step4: '04', step5: '05', step6: '06',
};

const slugTitles: Record<string, string> = {
  'usecase-creation-model-owner': 'Use Case Creation',
  'risk-review-rco': 'Risk Review (RCO)',
  'risk-endorsement-bul': 'Risk Endorsement',
  'model-developer-tasks': 'Developer Tasks',
  'model-developement': 'Model Development',
  'model-validator-tasks': 'Validator Tasks',
  'model-validation': 'Model Validation',
  'model-deployer-tasks': 'Deployer Tasks',
  'model-deployment': 'Model Deployment',
  'mitigating-incidents': 'Mitigating Incidents',
  'model-management-evals': 'Model Management Evals',
  'integrating-external-evals': 'Integrating External Evals',
};

const { entry } = Astro.props;
const parts = entry.id.split('/');
const step = parts[0];
const slug = parts[1];
const base = import.meta.env.BASE_URL;
const currentPath = `${base}/steps/${step}/${slug}`;
const pageTitle = slugTitles[slug] ?? slug;
const stepLabel = stepLabels[step] ?? step;
const stepNumber = stepNumbers[step] ?? '';

const { Content, headings } = await render(entry);
// Drop the first heading: it's the document's own title, already shown
// separately in the page header above the article.
const tocHeadings = headings.slice(1);

// Markdown source lives at steps/stepN/foo.md and uses GitHub-relative paths
// like "./assets/foo.png" or "../step5/assets/bar.png". The rendered page URL
// is /session-2-ai-governance/steps/stepN/slug/, so those relative paths don't
// resolve correctly in the browser — content-links.ts re-resolves them against
// this stepBase (the absolute URL standing in for the .md file's directory).
const stepBase = `${base}/steps/${step}`;

// Build a filename -> real route map so relative markdown links written for
// GitHub (e.g. "./risk-review-rco.md") resolve to this site's actual Astro
// routes instead of 404ing.
const allSteps = await getCollection('steps');
const routeMap: Record<string, string> = {};
for (const e of allSteps) {
  const [s, sl] = e.id.split('/');
  routeMap[sl] = `${base}/steps/${s}/${sl}`;
}

const contentLinksConfig = JSON.stringify({ siteBase: base, stepBase, routeMap });
---

<DocsLayout title={pageTitle} currentPath={currentPath} headings={tocHeadings}>
  <!-- Page header -->
  <div class="mb-8 pb-6 border-b border-gray-100">
    <p class="text-xs font-semibold tracking-widest uppercase text-violet-500 mb-2">
      Step {stepNumber} &nbsp;·&nbsp; {stepLabel}
    </p>
    <h1 class="text-3xl font-bold text-gray-900">{pageTitle}</h1>
  </div>

  <article
    data-assets-base={stepBase}
    class="prose prose-slate max-w-none
      prose-headings:font-bold prose-headings:text-gray-900
      prose-a:text-violet-600 prose-a:no-underline prose-a:hover:underline
      prose-code:bg-gray-100 prose-code:px-1 prose-code:rounded prose-code:text-sm
      prose-img:rounded-lg prose-img:border prose-img:border-gray-200 prose-img:shadow-sm
      prose-blockquote:border-violet-300 prose-blockquote:bg-violet-50 prose-blockquote:rounded-r-lg
      prose-table:text-sm">
    <Content />
  </article>

  <script type="application/json" id="content-links-config" set:html={contentLinksConfig} />
</DocsLayout>

<script>
  import { fixContentLinks } from '../../../scripts/content-links';
  fixContentLinks();
</script>
