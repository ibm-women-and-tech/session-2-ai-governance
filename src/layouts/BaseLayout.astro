---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Session 2 — AI Risk & Compliance with watsonx.governance" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — AI Risk & Compliance</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col overflow-x-hidden">

    <!-- Top nav -->
    <header class="border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-8 py-4 flex items-center justify-between">
        <div class="flex items-center gap-2 text-sm">
          <a href="https://ibm-women-and-tech.github.io" class="text-violet-600 hover:underline font-medium">IBM Women and Tech</a>
          <span class="text-gray-300">/</span>
          <span class="text-gray-500">Session 2</span>
        </div>
        <p class="hidden sm:block text-xs tracking-widest uppercase text-gray-400">AI Risk &amp; Compliance</p>
      </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer class="border-t border-gray-100 mt-auto">
      <div class="max-w-7xl mx-auto px-8 py-5 flex items-center justify-between text-xs text-gray-400">
        <span>Women &amp; Tech Event Series &nbsp;·&nbsp; IBM Innovation Studio</span>
        <span>built with <a href="https://astro.build" class="hover:underline">Astro</a></span>
      </div>
    </footer>

  </body>
</html>
