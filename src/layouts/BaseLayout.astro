---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Session 2 — AI Risk & Compliance with watsonx.governance" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} — AI Risk & Compliance</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col">

    <!-- Top nav -->
    <header class="bg-gray-900 text-white border-b border-gray-700">
      <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        <div>
          <a href={base} class="text-sm text-blue-400 hover:underline">← IBM Women and Tech</a>
          <span class="text-gray-500 mx-2">/</span>
          <span class="text-sm text-gray-300">Session 2 — AI Risk &amp; Compliance</span>
        </div>
      </div>
    </header>

    <slot />

    <!-- Footer -->
    <footer class="border-t border-gray-200 mt-auto">
      <div class="max-w-7xl mx-auto px-6 py-5 text-center text-xs text-gray-400">
        IBM Women and Tech &mdash; Session 2 &mdash; built with <a href="https://astro.build" class="hover:underline">Astro</a>
      </div>
    </footer>

  </body>
</html>
